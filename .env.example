# Private dashboard gate (server-only)
DASHBOARD_PASSWORD=
DASHBOARD_SESSION_SECRET=

# Pinterest Developer app credentials (keep secret server-side)
PINTEREST_CLIENT_ID=
PINTEREST_CLIENT_SECRET=
PINTEREST_REDIRECT_URI=http://localhost:3000/api/pinterest/callback
# 32-byte key encoded as 64 hex characters. Generate: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=
# Supabase project credentials; service role key must NEVER be exposed to browser
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Random long secret used to protect scheduled job endpoint
CRON_SECRET=
APP_URL=http://localhost:3000

# Temporary Pinterest publishing via Buffer (server-only)
BUFFER_API_KEY=
BUFFER_MODE=test
# Optional selectors when more than one organization/channel/board exists
BUFFER_ORGANIZATION_ID=
BUFFER_CHANNEL_ID=
BUFFER_BOARD_SERVICE_ID=

# Optional paid AI text generation; without a key PinPilot uses safe rule-based copy
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Set true only after official Pinterest analytics scopes are approved
PINTEREST_ANALYTICS_ENABLED=false
