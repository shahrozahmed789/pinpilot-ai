# Pinterest Developer app credentials (keep secret server-side)
PINTEREST_CLIENT_ID=
PINTEREST_CLIENT_SECRET=
PINTEREST_REDIRECT_URI=http://localhost:3000/api/pinterest/callback
# 32-byte key encoded as 64 hex characters. Generate: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=
# Supabase project credentials; service role key must NEVER be exposed to browser
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Random long secret used to protect scheduled job endpoint
CRON_SECRET=
APP_URL=http://localhost:3000
